{
    "name": "sailantis/azera-volucer",
    "description": "Application-server adapter that lets Azera run on volucer. Serves HTTP from persistent PHP workers that reuse the Azera AppContext DI container, Router, Dispatcher and middleware pipeline.",
    "type": "library",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../azera-framework" },
        { "type": "path", "url": "../clarity-engine" },
        { "type": "path", "url": "../volucer-php-sdk" }
    ],
    "require": {
        "php": ">=8.2",
        "sailantis/azera-framework": "dev-main",
        "sailantis/volucer-worker": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Azera\\Volucer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azera\\Volucer\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/sailantis/azera-volucer/issues",
        "source": "https://github.com/sailantis/azera-volucer"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
