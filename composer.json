{
    "name": "sailantis/azera-stokehold",
    "description": "Application-server adapter that lets Azera run on stokehold. Serves HTTP from persistent PHP workers that reuse the Azera AppContext DI container, Router, Dispatcher and middleware pipeline.",
    "type": "library",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../azera-framework" },
        { "type": "path", "url": "../clarity-engine" },
        { "type": "path", "url": "../stokehold-php-sdk" }
    ],
    "require": {
        "php": ">=8.2",
        "sailantis/azera-framework": "dev-main",
        "sailantis/stokehold-worker": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Azera\\Stokehold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azera\\Stokehold\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/sailantis/azera-stokehold/issues",
        "source": "https://github.com/sailantis/azera-stokehold"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php -d session.use_cookies=0 -d session.cache_limiter= vendor/bin/phpunit"
    }
}
